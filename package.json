{
  "name": "wikiprepared",
  "version": "1.0.1",
  "description": "Create offline Wikipedia USB drives with WikiPrepared - download and manage Wikipedia content for offline access",
  "main": "src/main/index.js",
  "author": {
    "name": "WikiPrepared",
    "email": "admin@wikiprepared.com"
  },
  "license": "GPL-3.0",
  "keywords": [
    "kiwix",
    "wikipedia",
    "offline",
    "zim",
    "usb",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/coding-crying/WikiPrepared.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "webpack:prod": "rimraf build && webpack --config webpack.prod.main.config.js && webpack --config webpack.prod.renderer.config.js",
    "dist": "npm run webpack:prod && node scripts/run-electron-builder.js",
    "dist:win": "npm run webpack:prod && node scripts/run-electron-builder.js --win",
    "dist:mac": "npm run webpack:prod && node scripts/run-electron-builder.js --mac",
    "dist:linux": "npm run webpack:prod && node scripts/run-electron-builder.js --linux",
    "dist:all": "npm run webpack:prod && node scripts/run-electron-builder.js --win --mac --linux",
    "make": "electron-forge make",
    "build": "electron-forge make",
    "build:win": "electron-forge make --platform=win32",
    "build:linux": "electron-forge make --platform=linux",
    "build:mac": "electron-forge make --platform=darwin",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^2.30.0",
    "drivelist": "^11.1.0",
    "electron-squirrel-startup": "^1.0.0",
    "filesize": "^10.1.0",
    "form-data": "^4.0.0",
    "fs-extra": "^11.2.0",
    "progress-stream": "^2.0.0",
    "react-icons": "^5.5.0",
    "sanitize-filename": "^1.6.3",
    "semver": "^7.5.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-dmg": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-webpack": "^7.2.0",
    "@electron/rebuild": "^3.4.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.1",
    "@mui/material": "^5.15.1",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "html-webpack-plugin": "^5.5.4",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "rimraf": "^6.1.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^6.0.1",
    "zustand": "^4.4.7"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "WikiPrepared",
        "executableName": "wikiprepared",
        "icon": "./public/icons/icon",
        "asar": true,
        "extraResource": [
          "src/main/assets"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "wikiprepared",
            "setupIcon": "./public/icons/icon.ico"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "linux"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {
            "options": {
              "maintainer": "WikiPrepared",
              "homepage": "https://github.com/coding-crying/WikiPrepared",
              "icon": "./public/icons/icon.png"
            }
          }
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "icon": "./public/icons/icon.icns",
            "name": "WikiPrepared"
          }
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-webpack",
          "config": {
            "loggerPort": 9010,
            "mainConfig": "./webpack.main.config.js",
            "renderer": {
              "config": "./webpack.renderer.config.js",
              "entryPoints": [
                {
                  "html": "./public/index.html",
                  "js": "./src/renderer/index.jsx",
                  "name": "main_window",
                  "preload": {
                    "js": "./src/main/preload.js"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
