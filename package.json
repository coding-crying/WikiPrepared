{
  "name": "kiwix-usb-updater",
  "version": "0.1.0",
  "description": "A cross-platform desktop application for managing Kiwix reader installations and Wikipedia ZIM files on USB drives",
  "main": "src/main/index.js",
  "author": "Your Name",
  "license": "GPL-3.0",
  "keywords": [
    "kiwix",
    "wikipedia",
    "offline",
    "zim",
    "usb",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/kiwix-usb-updater.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "electron-forge make",
    "build:win": "electron-forge make --platform=win32",
    "build:linux": "electron-forge make --platform=linux",
    "build:mac": "electron-forge make --platform=darwin",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^2.30.0",
    "drivelist": "^11.1.0",
    "filesize": "^10.1.0",
    "fs-extra": "^11.2.0",
    "progress-stream": "^2.0.0",
    "sanitize-filename": "^1.6.3",
    "semver": "^7.5.4",
    "uuid": "^9.0.1",
    "electron-squirrel-startup": "^1.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-dmg": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-webpack": "^7.2.0",
    "@electron/rebuild": "^3.4.0",
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.1",
    "@mui/material": "^5.15.1",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "html-webpack-plugin": "^5.5.4",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "zustand": "^4.4.7"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "Kiwix USB Updater",
        "executableName": "kiwix-usb-updater",
        "icon": "./public/icons/icon",
        "asar": true
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "kiwix_usb_updater",
            "setupIcon": "./public/icons/icon.ico",
            "iconUrl": "https://example.com/icon.ico"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "linux"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {
            "options": {
              "maintainer": "Your Name",
              "homepage": "https://github.com/yourusername/kiwix-usb-updater",
              "icon": "./public/icons/icon.png"
            }
          }
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "icon": "./public/icons/icon.icns",
            "name": "Kiwix USB Updater"
          }
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-webpack",
          "config": {
            "mainConfig": "./webpack.main.config.js",
            "renderer": {
              "config": "./webpack.renderer.config.js",
              "entryPoints": [
                {
                  "html": "./public/index.html",
                  "js": "./src/renderer/index.jsx",
                  "name": "main_window",
                  "preload": {
                    "js": "./src/main/preload.js"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
